# Synology DS923+ / Container Manager
NAS_DATA_DIR=/volume1/docker/factiun-mapa-tcu/data
NAS_BIND_IP=127.0.0.1
NAS_HTTP_PORT=8787
# Cuenta comercial autorizada (no usar la API gratuita para Factiun)
OPEN_METEO_API_KEY=
# Solo para peticiones desde la interfaz (no almacenar en Git)
FACTIUN_MAPA_TOKEN=
ENABLE_UI_QUEUE=0
METEO_GAP_MS=2500

# Máximo de trabajos mundiales simultáneamente en espera; el cálculo es serial
WORLD_QUEUE_BUFFER=12
# Pausa los cálculos si el volumen NAS baja de este espacio libre (GB)
MIN_DISK_FREE_GB=20
